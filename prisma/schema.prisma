generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Настройки приложения (key-value): baseUrl сайта, голос, плеер и т.д.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// История голосовых команд (только текст, без аудио)
model CommandHistoryEntry {
  id         String   @id @default(cuid())
  raw        String
  normalized String
  command    String
  params     String   @default("{}")
  confidence Float
  success    Boolean
  message    String?
  source     String   @default("voice") // voice | text | gui | llm
  createdAt  DateTime @default(now())
}

// Сохранённая сессия вкладок
model TabSession {
  id        String   @id @default(cuid())
  position  Int
  kind      String // home | section | search | anime | player
  title     String
  url       String   @default("")
  payload   String   @default("{}") // JSON: sectionId / animeId / query / episode / dub
  active    Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

// Пользователь (прототип: username + scrypt-хеш, сессия через подписанную cookie)
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  library      UserLibraryEntry[]
  aliases      VoiceAlias[]
}

// Библиотека аниме пользователя (статусы просмотра, избранное, прогресс)
model UserLibraryEntry {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  animeId        Int
  title          String
  slug           String?
  poster         String?
  status         String   @default("watching") // watching|planned|completed|dropped|on_hold
  favorite       Boolean  @default(false)
  episode        Int?
  positionSec    Float?
  totalEpisodes  Int?
  currentDub     String?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@unique([userId, animeId])
  @@index([userId, updatedAt])
}

// Пользовательские алиасы (озвучки/аниме/секции/команды) для голосового резолвера
model VoiceAlias {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType String   @default("voice") // voice | anime | section | command
  targetName String   // напр. "AniLibria" (официальное имя на сайте)
  alias      String   // напр. "ани либрия"
  createdAt  DateTime @default(now())

  @@unique([userId, targetType, targetName, alias])
}

